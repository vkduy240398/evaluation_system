sable":true}, {"evaluation_id":1149,"job_type":"ディレクター","item_id":"qp8g_0_2","item_no":2,"item_title":"企画業務_企画_ビジネス企画","content":"ビジネス課題に対し打ち手となるビジネスモデル、コンセプト、それに付随する業務機能を要求として整理する事ができる","note":null,"difficulty":5,"point_user":4,"total_point_user":20,"point_evaluator_0_5":null,"total_point_evaluator_0_5":0,"point_evaluator_1":null,"total_point_evaluator_1":0,"point_evaluator_2":null,"total_point_evaluator_2":0,"created_time":"2026-01-27T01:02:43.233+00:00","updated_time":"2026-01-27T01:02:43.233+00:00","is_disable":false}, {"evaluation_id":1149,"job_type":"ディレクター","item_id":"tgay_0_3","item_no":3,"item_title":"企画業務_企画_システム企画","content":"ビジネス要求に対し、ＩＴ面での実現方法をシステム機能要求とし定義する事ができる","note":null,"difficulty":4,"point_user":3,"total_point_user":15,"point_evaluator_0_5":null,"total_point_evaluator_0_5":0,"point_evaluator_1":null,"total_point_evaluator_1":0,"point_evaluator_2":null,"total_point_evaluator_2":0,"created_time":"2026-01-27T01:02:43.233+00:00","updated_time":"2026-01-27T01:02:43.233+00:00","is_disable":false}, {"evaluation_id":1149,"job_type":"ディレクター","item_id":"vg6h_0_0","item_no":1,"item_title":"企画業務_企画_ビジネスの知識","content":"グループ全体のビジネスモデル・数値の把握、競合他社・市場の動向を把握し企画業務に活かす事ができる","note":null,"difficulty":3,"point_user":4,"total_point_user":18,"point_evaluator_0_5":null,"total_point_evaluator_0_5":0,"point_evaluator_1":null,"total_point_evaluator_1":0,"point_evaluator_2":null,"total_point_evaluator_2":0,"created_time":"2026-01-27T01:02:43.233+00:00","updated_time":"2026-01-27T01:02:43.233+00:00","is_disable":false}]	[{"evaluation_id":1149,"item_no":1,"type":4,"item_title":"社会責任\\n倫理","content":"社会人として自覚および社会的責任を持ち、日常業務に関する法的または倫理的な問題についても常に問題意識を持って取り組んでいる。","difficulty":1,"point_user":3,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-01-27T01:02:43.24+00:00","updated_time":"2026-01-27T01:02:43.24+00:00"}, {"evaluation_id":1149,"item_no":2,"type":4,"item_title":"業務計画","content":"社内・部署内で定められたスケジュールと自身のスケジュールに矛盾がなく、業務のロスとなるムダの発見と除去を行い、業務を推進している。","difficulty":1,"point_user":2,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-01-27T01:02:43.24+00:00","updated_time":"2026-01-27T01:02:43.24+00:00"}, {"evaluation_id":1149,"item_no":3,"type":4,"item_title":"リスク管理\\n問題意識","content":"業務上知り得た機密について漏洩や盗用が発生しないよう意識しており、自身が関連する職務や分野の時事問題について関心を持ち問題意識を持って取り組んでいる。","difficulty":1,"point_user":2,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-01-27T01:02:43.24+00:00","updated_time":"2026-01-27T01:02:43.24+00:00"}, {"evaluation_id":1149,"item_no":4,"type":4,"item_title":"安全指針\\n健康管理","content":"会社や所属部署における業務遂行上の安全に係る規程やルールを正確に把握し、遵守している。また、自身の健康状態を把握し上司へ適切に報告・連絡・相談を行っている。","difficulty":1,"point_user":3,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-01-27T01:02:43.24+00:00","updated_time":"2026-01-27T01:02:43.24+00:00"}, {"evaluation_id":1149,"item_no":5,"type":4,"item_title":"業務遂行","content":"業務遂行上の疑問点や不明点などについて、関係者への適時確認を行い適切に業務を遂行している。また、他部署の役割を理解し、助言や質問を求められた際には快く対応している。","difficulty":1,"point_user":2,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-01-27T01:02:43.24+00:00","updated_time":"2026-01-27T01:02:43.24+00:00"}, {"evaluation_id":1149,"item_no":6,"type":4,"item_title":"交渉・折衝","content":"説明事項を簡潔に漏れなく伝えることができ、事実と意見を区別し、適切な態度と言葉遣いで折衝や打ち合わせを行うことができている。","difficulty":1,"point_user":3,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-01-27T01:02:43.24+00:00","updated_time":"2026-01-27T01:02:43.24+00:00"}, {"evaluation_id":1149,"item_no":7,"type":5,"item_title":"経営ビジョン・方針理解","content":"経営ビジョン・方針について経営陣として深く理解をしており、職場全体に波及する言動を心がけるとともに、配下従業員への落としこみを行えているか","difficulty":4,"point_user":4,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-01-27T01:02:43.24+00:00","updated_time":"2026-01-27T01:02:43.24+00:00"}, {"evaluation_id":1149,"item_no":8,"type":5,"item_title":"報告・連絡・相談","content":"自身も全方位的に率先して報連相を行うと共に、配下従業員に対し適切な指導、指揮、命令、監督を行っているか","difficulty":3,"point_user":5,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-01-27T01:02:43.24+00:00","updated_time":"2026-01-27T01:02:43.24+00:00"}, {"evaluation_id":1149,"item_no":9,"type":5,"item_title":"知識","content":"管掌部門および経営管理手法などに関する高度な専門知識を有し、運営推進や効率化を行えているか","difficulty":3,"point_user":3,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-01-27T01:02:43.24+00:00","updated_time":"2026-01-27T01:02:43.24+00:00"}, {"evaluation_id":1149,"item_no":10,"type":5,"item_title":"決断","content":"会社の方針に沿いながら、管掌部門全体に関する問題の解決方向を的確に決断することができる能力を有し実践できているか","difficulty":5,"point_user":2,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-01-27T01:02:43.24+00:00","updated_time":"2026-01-27T01:02:43.24+00:00"}, {"evaluation_id":1149,"item_no":11,"type":5,"item_title":"統率・指導","content":"部、課、プロジェクトチームにて実行中の業務を適時把握し、必要に応じ評価、指導、指揮、命令、監督することにより、部下の執務意欲の向上や業務の効率的推進などの指導管理ができているか","difficulty":5,"point_user":2,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-01-27T01:02:43.24+00:00","updated_time":"2026-01-27T01:02:43.24+00:00"}, {"evaluation_id":1149,"item_no":12,"type":5,"item_title":"渉外・折衝","content":"管掌部門全般に関する業務について関係者と折衝し、納得性の高い解決ができる能力を有し実践できているか","difficulty":5,"point_user":4,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-01-27T01:02:43.24+00:00","updated_time":"2026-01-27T01:02:43.24+00:00"}, {"evaluation_id":1149,"item_no":13,"type":5,"item_title":"企画","content":"会社全体あるいは管掌部門に関する現状と見通しを踏まえて、問題の所在を的確に把握し、効果的かつ現実性のある企画立案を行っているか","difficulty":5,"point_user":5,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-01-27T01:02:43.24+00:00","updated_time":"2026-01-27T01:02:43.24+00:00"}, {"evaluation_id":1149,"item_no":14,"type":5,"item_title":"変革行動","content":"経費抑制や効率化、成果に繋がる業務改善また変革のための施策を立案・実行でき、配下従業員に対して指導管理ができているか","difficulty":5,"point_user":4,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-01-27T01:02:43.24+00:00","updated_time":"2026-01-27T01:02:43.24+00:00"}, {"evaluation_id":1149,"item_no":15,"type":5,"item_title":"向上心・自己啓発","content":"常に社内外の情報や知識に関心を持ち、統括組織の範囲を超えた情報を収集して業務に活用しているか","difficulty":4,"point_user":4,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-01-27T01:02:43.24+00:00","updated_time":"2026-01-27T01:02:43.24+00:00"}, {"evaluation_id":1149,"item_no":16,"type":5,"item_title":"5Sの徹底","content":"自らが率先して徹底するとともに、配下従業員に対して指導、指揮、命令、監督することができているか","difficulty":1,"point_user":3,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-01-27T01:02:43.24+00:00","updated_time":"2026-01-27T01:02:43.24+00:00"}]	2026-01-27 06:07:12.736694+00	2026-01-27 06:07:12.736694+00	[{"evaluation_id":1149,"evaluator_id":1,"evaluation_order":2.0,"comment_public":null,"comment_private":null,"created_time":"2026-01-26T04:02:45.662+00:00","updated_time":"2026-01-26T04:02:45.662+00:00"}]	[{"id":4416,"evaluation_id":1149,"comment":null,"approver_id":186,"receiver_id":null,"receiver_order":0.0,"type":0,"status":"提出","created_time":"2026-01-26T04:28:04.804+00:00","updated_time":"2026-01-26T04:28:04.804+00:00"}, {"id":4418,"evaluation_id":1149,"comment":"","approver_id":1,"receiver_id":null,"receiver_order":null,"type":0,"status":"IDS_APPROVE","created_time":"2026-01-26T04:28:37.22+00:00","updated_time":"2026-01-26T04:28:37.22+00:00"}, {"id":4419,"evaluation_id":1149,"comment":"[{\\"key\\":\\"lgpj_0_1\\",\\"note\\":null,\\"itemId\\":\\"lgpj_0_1\\",\\"itemNo\\":0,\\"content\\":\\"社内システム、ＩＴのトレンドを把握し企画業務に活かす事ができる\\",\\"jobType\\":\\"ディレクター\\",\\"isDisable\\":true,\\"itemTitle\\":\\"企画業務_企画_ＩＴの知識\\",\\"pointUser