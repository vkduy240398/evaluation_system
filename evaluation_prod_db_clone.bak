kground-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;white-space:pre-wrap;">3%～5%未満</span></p>\n                    </td>\n                    <td style="border-left:solid #000000 0.50000025pt;border-right:solid #000000 0.50000025pt;border-bottom:solid #000000 0.50000025pt;border-top:solid #000000 0.50000025pt;vertical-align:bottom;padding:2pt 2pt 2pt 2pt;overflow:hidden;overflow-wrap:break-word;">\n                        <p dir="ltr" style="line-height:1.38;text-align: center;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:11pt;font-family:Arial,sans-serif;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;white-space:pre-wrap;">0.9</span></p>\n                    </td>\n                </tr>\n                <tr style="height:17.25pt">\n                    <td style="border-left:solid #000000 0.50000025pt;border-right:solid #000000 0.50000025pt;border-bottom:solid #000000 0.50000025pt;border-top:solid #000000 0.50000025pt;vertical-align:bottom;padding:2pt 2pt 2pt 2pt;overflow:hidden;overflow-wrap:break-word;">\n                        <p dir="ltr" style="line-height:1.38;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:11pt;font-family:Arial,sans-serif;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;white-space:pre-wrap;">5%超過</span></p>\n                    </td>\n                    <td style="border-left:solid #000000 0.50000025pt;border-right:solid #000000 0.50000025pt;border-bottom:solid #000000 0.50000025pt;border-top:solid #000000 0.50000025pt;vertical-align:bottom;padding:2pt 2pt 2pt 2pt;overflow:hidden;overflow-wrap:break-word;">\n                        <p dir="ltr" style="line-height:1.38;text-align: center;margin-top:0pt;margin-bottom:0pt;"><span style="font-size:11pt;font-family:Arial,sans-serif;color:#000000;background-color:transparent;font-weight:400;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre;white-space:pre-wrap;">0.8</span></p>\n                    </td>\n                </tr>\n            </tbody>\n        </table>\n    </div><br style="line-height: 1.1;">\n</strong><br class="Apple-interchange-newline"><br>	\N	2024/5/22 10:09	2024-05-22 01:09:44.11+00	2025-10-02 02:50:19.924+00	GNW
21	3	2	0	3	\N	Tạo version đầu tiên	<br><table style="border-collapse:collapse;width: 100%;"><tbody>\n<tr>\n\t<td style="width: 11.2429%;"><br></td>\n\t<td style="width: 17.3446%; text-align: center;">5&nbsp;<br>Xuất sắc</td>\n\t<td style="width: 14.2857%; text-align: center;">4<br>Tốt</td>\n\t<td style="width: 14.2857%; text-align: center;">3<br>Đạt chuẩn</td>\n\t<td style="width: 14.2857%; text-align: center;">2<br>Cần cải thiện</td>\n\t<td style="width: 14.2857%; text-align: center;">1<br>Kém</td>\n\t<td style="width: 14.2857%; text-align: center;">0<br>Rất kém</td></tr>\n<tr>\n\t<td>Hiểu Định hướng - Tầm nhìn kinh doanh<br></td>\n\t<td>Nắm rõ quan điểm kinh doanh, triết lý công ty, 4 hướng dẫn cho công việc, 5 hướng dẫn về hành vi, 10 bài học, được đánh giá cao tại nơi làm việc và trở thành tấm gương cho mọi người.<br></td>\n\t<td style="width: 14.2857%;">Hiểu quan điểm kinh doanh, triết lý công ty, 4 hướng dẫn cho công việc, 5 hướng dẫn về hành vi, 10 bài học, đóng vai trò làm gương thực hiện.<br></td>\n\t<td style="width: 14.2857%;">Hành động dựa trên quan điểm kinh doanh, triết lý công ty, 4 hướng dẫn cho công việc, 5 hướng dẫn về hành vi, 10 bài học.<br></td>\n\t<td style="width: 14.2857%;">Đôi khi không hiểu và không tuân thủ quan điểm kinh doanh, triết lý công ty, 4 hướng dẫn cho công việc, 5 hướng dẫn về hành vi, 10 bài học.<br></td>\n\t<td style="width: 14.2857%;">Không hiểu và không tuân thủ quan điểm kinh doanh, triết lý công ty, 4 hướng dẫn cho công việc, 5 hướng dẫn về hành vi, 10 bài học.<br></td>\n\t<td style="width: 14.2857%;">Vi phạm quan điểm kinh doanh, triết lý công ty, 4 hướng dẫn cho công việc, 5 hướng dẫn về hành vi, 10 bài học.<br></td></tr>\n<tr>\n\t<td>Báo cáo - Liên lạc - Bàn bạc<br></td>\n\t<td>Tích cực thực hiện, và làm gương cho những người xunh quanh.<br></td>\n\t<td style="width: 14.2857%;">Tích cực thực hiện một cách phù hợp.<br></td>\n\t<td style="width: 14.2857%;">Thực hiện ở một mức độ phù hợp khi cần thiết.<br></td>\n\t<td style="width: 14.2857%;">Có thực hiện khi cần thiết nhưng mức độ chưa phù hợp.<br></td>\n\t<td style="width: 14.2857%;">Hầu như không tự mình thực hiện.<br></td>\n\t<td style="width: 14.2857%;">Hoàn toàn không thực hiện.<br></td></tr>\n<tr>\n\t<td>Tri thức<br></td>\n\t<td>Đứng đầu về tri thức, kỹ thuật, công nghệ, là tấm gương cho các thành viên khác.<br></td>\n\t<td style="width: 14.2857%;">Hiểu các công việc khác ngoài phạm vi công việc của bản thân và hướng dẫn cho các thành viên khác.<br></td>\n\t<td style="width: 14.2857%;">Hiểu rõ nghiệp vụ của bản thân, hoàn toàn không gây tổn thất gì cho công việc.<br></td>\n\t<td style="width: 14.2857%;">Có kiến thức nhưng chưa thể đưa vào áp dụng cụ thể trong thực tế.<br></td>\n\t<td style="width: 14.2857%;">Ở trình độ cần có lời khuyên và hướng dẫn từ người khác.<br></td>\n\t<td style="width: 14.2857%;">Không có kiến thức và cũng không chịu nghe hướng dẫn.<br></td></tr>\n<tr>\n\t<td>Hoàn thành công việc<br></td>\n\t<td>Ngay cả những công việc khó khăn cũng không làm khó được bản thân, kết quả đầu ra vượt trên cả mong đợi.<br></td>\n\t<td style="width: 14.2857%;">Ngay cả những việc tương đối khó khăn cũng thực hiện được chính xác, không lỗi, đáng tin cậy.<br></td>\n\t<td style="width: 14.2857%;">Hoàn thành công việc ở mức độ được cấp trên kì vọng và không gây ra sai lầm.<br></td>\n\t<td style="width: 14.2857%;">Thỉnh thoảng mắc lỗi, hoặc là gây thiệt hại cho công việc.<br></td>\n\t<td style="width: 14.2857%;"> Thường xuyên mắc lỗi và gây rắc rối, cản trở công việc và gây ra bất mãn.<br></td>\n\t<td style="width: 14.2857%;">Gây ra lỗi không thể chấp nhận.<br></td></tr>\n<tr>\n\t<td>Diễn đạt<br></td>\n\t<td>Vừa diễn giải để đối phương hiểu đầy đủ và chấp nhận ý định của bản thân, vừa xúc tiến công việc theo nhịp độ của mình.<br></td>\n\t<td style="width: 14.2857%;">Biết cách diễn đạt dễ hiểu, khiến đối phương hiểu rõ và chấp nhận.<br></td>\n\t<td style="width: 14.2857%;">Biết cách diễn đạt để đối phương hiểu, không gây cản trở gì cho công việc.<br></td>\n\t<td style="width: 14.2857%;">Có cố gắng nhưng không thể truyền đạt tới đối phương đầy đủ ý định của bản thân, dẫn đến những hiểu lầm.<br></td>\n\t<td style="width: 14.2857%;">Thỉnh thoảng có những hành động và lời nói không rõ ràng, làm phiền người khác, làm người khác khó chịu.<br></td>\n\t<td style="width: 14.2857%;">Không có khả năng diễn đạt.<br></td></tr>\n<tr>\n\t<td>Sáng tạo<br></td>\n\t<td>Luôn đứng trên quan điểm toàn công ty và đưa ra những cải tiến hoặc đề xuất, luôn là người đi đầu.<br></td>\n\t<td style="width: 14.2857%;">Kết hợp đào sâu nghiên cứu với sự cải tiến để hoàn thành công việc của bản thân một cách hiệu quả.<br></td>\n\t<td style="width: 14.2857%;">Không bằng lòng với hiện tại, luôn tự cải thiện công việc hàng ngày của mình.<br></td>\n\t<td style="width: 14.2857%;">Công việc đang dần mất đi sự sáng tạo, cứ lặp đi lặp lại nhưng bản thân vẫn cho rằng điều đó là bình thường.<br></td>\n\t<td style="width: 14.2857%;">Không muốn có thay đổi trong công việc hiện tại, nếu nhận phải chỉ trích từ người khác liền có thái độ chống đối.<br></td>\n\t<td style="width: 14.2857%;">Không sáng tạo và luôn phủ định sự sáng tạo của người khác.<br></td></tr>\n<tr>\n\t<td>Thực hiện cải tiến<br></td>\n\t<td>Nhanh chóng nắm bắt mục đích và nội dung của công việc, đưa ra đề xuất cải tiến chính xác và gây ấn tượng với cấp trên.<br></td>\n\t<td style="width: 14.2857%;">Khiến cấp trên hài lòng bằng việc nắm rõ nội dung công việc và đề xuất cả tiến.<br></td>\n\t<td style="width: 14.2857%;">Hiểu vai trò và nội dung công việc của bản thân, cũng có lúc đưa ra được đề xuất cải tiến.<br></td>\n\t<td style="width: 14.2857%;">Cũng có lúc đề xuất phương án cải tiến nhưng do không hiểu nội dung công việc nên thường không đúng mục đích.<br></td>\n\t<td style="width: 14.2857%;">Không có cải tiến trong công việc, thường xuyên nói ra những lời bất mãn đối với công việc.<br></td>\n\t<td style="width: 14.2857%;">Hoàn toàn không cảm nhận được sự cải tiến.<br></td></tr>\n<tr>\n\t<td>Sự cầu tiến - \nTự bồi dưỡng kiến thức<br></td>\n\t<td>Đóng vai trò chủ đạo trong tất cả các công việc, đem lại ảnh hưởng tốt cho những người khác.<br></td>\n\t<td style="width: 14.2857%;">Luôn tích cực hành động với một động lực lớn.<br></td>\n\t<td style="width: 14.2857%;">Luôn có thái độ tích cực hành động.<br></td>\n\t<td style="width: 14.2857%;">Đôi khi thiếu thái độ tích cực.<br></td>\n\t<td style="width: 14.2857%;">Chỉ có thể hành động với một thái độ thụ động. <br></td>\n\t<td style="width: 14.2857%;">Hoàn toàn không cảm nhận được sự tích cực, cũng không thấy bất cứ sự cải thiện nào.<br></td></tr>\n<tr>\n\t<td>Thực hiện triệt để 5S<br></td>\n\t<td>Luôn duy trì sự nỗ lực để làm gương cho người khác.<br></td>\n\t<td style="width: 14.2857%;">Có năng lực quản tự quản lý bản thân tốt, đáng tin cậy.<br></td>\n\t<td style="width: 14.2857%;">Nhìn chung không có vấn đề gì.<br></td>\n\t<td style="width: 14.2857%;">Tạo cảm giác lo lắng về khả năng tự quản lý bản thân.<br></td>\n\t<td style="width: 14.2857%;">Không thể tự quản lý bản thân.<br></td>\n\t<td style="width: 14.2857%;">Được hướng dẫn nhiều lần những vẫn không cải thiện.<br></td></tr><tr>\n\t<td>Chấm công<br></td>\n\t<td>Luôn duy trì sự nỗ lực để làm gương cho người khác.<br></td>\n\t<td style="width: 14.2857%;">Có năng lực quản tự quản lý bản thân tốt, đáng tin cậy.<br></td>\n\t<td style="width: 14.2857%;">Nhìn chung không có vấn đề gì.<br></td>\n\t<td style="width: 14.2857%;">Tạo cảm giác lo lắng về khả năng tự quản lý bản thân.<br></td>\n\t<td style="width: 14.2857%;">Không thể tự quản lý bản thân.<br></td>\n\t<td style="width: 14.2857%;">Được hướng dẫn nhiều lần những vẫn không cải thiện.<br></td></tr><tr>\n\t<td>Thái độ làm việc<br></td>\n\t<td>Luôn duy trì sự nỗ lực để làm gương cho người khác.<br></td>\n\t<td style="width: 14.2857%;">Có năng lực quản tự quản lý bản thân tốt, đáng tin cậy.<br></td>\n\t<td style="width: 14.2857%;">Nhìn chung không có vấn đề gì.<br></td>\n\t<td style="width: 14.2857%;">Tạo cảm giác lo lắng về khả năng tự quản lý bản thân.<br></td>\n\t<td style="width: 14.2857%;">Không thể tự quản lý bản thân.<br></td>\n\t<td style="width: 14.2857%;">Được hướng dẫn nhiều lần những vẫn không cải thiện.<br></td></tr></tbody></table><br>	<p style="text-align: center;"><google-sheets-html-origin><style type="text/css"><!--td {border: 1px solid #cccccc;}br {mso-data-placement:same-cell;}--></style><br></google-sheets-html-origin></p><p style="text-align: center;"><br></p><table style="border-collapse: collapse; width: 31.0169%; text-align: center;"><tbody>\n<tr>\n\t<td style="width: 30.6011%;">Điểm đánh giá<br></td>\n\t<td style="width: 34.9727%;">Hệ số đánh giá<br></td>\n\t<td style="width: 34.2441%;">Thay đổi mức lương<br></td></tr>\n<tr>\n\t<td>97 - 100</td>\n\t<td>2.4</td>\n\t<td>+10</td></tr>\n<tr>\n\t<td>92 - 96</td>\n\t<td>2.3</td>\n\t<td>+8</td></tr>\n<tr>\n\t<td>86 - 81</td>\n\t<td>2.2</td>\n\t<td>+7</td></tr>\n<tr>\n\t<td>80 -  85</td>\n\t<td>2.1</td>\n\t<td>+6</td></tr>\n<tr>\n\t<td>74 - 79</td>\n\t<td>2.0</td>\n\t<td>+5</td></tr>\n<tr>\n\t<td>68 - 73</td>\n\t<td>1.9</td>\n\t<td>+4</td></tr>\n<tr>\n\t<td>63 - 67</td>\n\t<td>1.8</td>\n\t<td>+3</td></tr>\n<tr>\n\t<td>57 - 62</td>\n\t<td>1.7</td>\n\t<td>+2</td></tr>\n<tr>\n\t<td>51 - 56</td>\n\t<td>1.6</td>\n\t<td>+1</td></tr><tr>\n\t<td>45 - 50</td>\n\t<td>1.5</td>\n\t<td>0</td></tr><tr>\n\t<td>39 - 44</td>\n\t<td>1.4</td>\n\t<td>-1</td></tr><tr>\n\t<td>33 - 38</td>\n\t<td>1.3</td>\n\t<td>-2</td></tr><tr>\n\t<td>27 - 32</td>\n\t<td>1.2</td>\n\t<td>-3</td></tr><tr>\n\t<td>21 - 26</td>\n\t<td>1.1</td>\n\t<td>-4</td></tr><tr>\n\t<td>15 - 20</td>\n\t<td>1.0</td>\n\t<td>-5</td></tr><tr>\n\t<td>9 - 14</td>\n\t<td>0.9</td>\n\t<td>-7</td></tr><tr>\n\t<td>4 - 8</td>\n\t<td>0.8</td>\n\t<td>-8</td></tr><tr>\n\t<td>0 - 3</td>\n\t<td>0.7</td>\n\t<td>-10</td></tr></tbody></table><table style="border-collapse: collapse; width: 55.7983%; text-align: center;"><tbody>\n<tr>\n\t<td style="width: 22.0648%;">Nhiệm vụ<br></td>\n\t<td style="width: 19.1296%;">Đánh giá thành tích<br></td>\n\t<td style="width: 15.9919%;">Tiêu chuẩn xếp loại<br></td>\n\t<td style="width: 19.7368%;">Đánh giá lần 1<br></td>\n\t<td style="width: 22.9757%;">Đánh giá lần 2<br></td></tr>\n<tr>\n\t<td>Trưởng phòng<br></td>\n\t<td>60%<br></td>\n\t<td>40%<br></td>\n\t<td>Phó bộ phận<br></td>\n\t<td>Trưởng phòng trụ sở chính<br></td></tr>\n<tr>\n\t<td>Trợ lý trưởng phòng<br></td>\n\t<td>50%<br></td>\n\t<td>50%<br></td>\n\t<td>Trưởng phòng<br></td>\n\t<td>Phó bộ phận<br></td></tr>\n<tr>\n\t<td>Leader<br></td>\n\t<td>40%<br></td>\n\t<td>60%<br></td>\n\t<td>Trưởng phòng<br></td>\n\t<td>Phó bộ phận<br></td></tr>\n<tr>\n\t<td>Nhân viên văn phòng cấp cao\n(tốt nghiệp đại học)<br></td>\n\t<td>30%<br></td>\n\t<td>70%<br></td>\n\t<td>Trưởng phòng<br></td>\n\t<td>Phó bộ phận<br></td></tr>\n<tr>\n\t<td>Nhân viên văn phòng trung cấp\n(tốt nghiệp cao đẳng)<br></td>\n\t<td>30%<br></td>\n\t<td>70%<br></td>\n\t<td>Trưởng phòng<br></td>\n\t<td>Phó bộ phận<br></td></tr>\n<tr>\n\t<td>Nhân viên văn phòng mới ra trường\n(tốt nghiệp THPT)<br></td>\n\t<td>30%<br></td>\n\t<td>70%<br></td>\n\t<td>Trưởng phòng<br></td>\n\t<td>Phó bộ phận<br></td></tr></tbody></table>\n <p style="text-align: center;"><br><br></p><p style="text-align: center;"><br></p><p style="text-align: center;"><br></p>	\N	2025/3/21 16:47	2025-03-21 06:50:23.68+00	2026-03-05 02:38:12.698+00	GSOL
