--
-- Name: v_evaluation_achievement_addition; Type: VIEW; Schema: public; Owner: Haako
--

CREATE VIEW public.v_evaluation_achievement_addition AS
 SELECT "evaluationId",
    type,
    jsonb_agg(row_to_json(t.*)) AS "evaluationAchievementAdditionals"
   FROM ( SELECT evaluation_achievement_additional_tbl.evaluation_id AS "evaluationId",
            evaluation_achievement_additional_tbl.item_no AS "itemNo",
            evaluation_achievement_additional_tbl.title_additional AS "titleAdditional",
            evaluation_achievement_additional_tbl.achievement_status AS "achievementStatus",
            evaluation_achievement_additional_tbl.reason_comment AS "reasonComment",
            evaluation_achievement_additional_tbl.point_user AS "pointUser",
            evaluation_achievement_additional_tbl.point_evaluator_0_5 AS "pointEvaluator05",
            evaluation_achievement_additional_tbl.point_evaluator_1 AS "pointEvaluator1",
            evaluation_achievement_additional_tbl.point_evaluator_2 AS "pointEvaluator2",
            evaluation_achievement_additional_tbl.evaluation_order AS "evaluationOrder",
            evaluation_achievement_additional_tbl.type
           FROM public.evaluation_achievement_additional_tbl
          ORDER BY evaluation_achievement_additional_tbl.item_no) t
  GROUP BY "evaluationId", type;


ALTER VIEW public.v_evaluation_achievement_addition OWNER TO "Haako";

--
-- Name: v_evaluation_achievement_personal; Type: VIEW; Schema: public; Owner: Haako
--

CREATE VIEW public.v_evaluation_achievement_personal AS
 SELECT "evaluationId",
    type,
    jsonb_agg(row_to_json(t.*)) AS "evaluationAchievementPersonals"
   FROM ( SELECT "EvaluationAchievementPersonal".achievement_status AS "achievementStatus",
            "EvaluationAchievementPersonal".achievement_value AS "achievementValue",
            "EvaluationAchievementPersonal".action_plan AS "actionPlan",
            ("EvaluationAchievementPersonal".coefficient_evaluator_1)::character varying AS "coefficientEvaluator1",
            ("EvaluationAchievementPersonal".coefficient_evaluator_0_5)::character varying AS "coefficientEvaluator05",
            ("EvaluationAchievementPersonal".coefficient_evaluator_2)::character varying AS "coefficientEvaluator2",
            ("EvaluationAchievementPersonal".coefficient_user)::character varying AS "coefficientUser",
            ("EvaluationAchievementPersonal".difficulty_user)::character varying AS "difficultyUser",
            ("EvaluationAchievementPersonal".difficulty_evaluator_0_5)::character varying AS "difficultyEvaluator05",
            ("EvaluationAchievementPersonal".difficulty_evaluator_1)::character varying AS "difficultyEvaluator1",
            ("EvaluationAchievementPersonal".difficulty_evaluator_2)::character varying AS "difficultyEvaluator2",
            "EvaluationAchievementPersonal".evaluation_id AS "evaluationId",
            "EvaluationAchievementPersonal".id,
            "EvaluationAchievementPersonal".item_no AS "itemNo",
            "EvaluationAchievementPersonal".method,
            "EvaluationAchievementPersonal".point_user AS "pointUser",
            "EvaluationAchievementPersonal".point_evaluator_0_5 AS "pointEvaluator05",
            "EvaluationAchievementPersonal".point_evaluator_1 AS "pointEvaluator1",
            "EvaluationAchievementPersonal".point_evaluator_2 AS "pointEvaluator2",
            "EvaluationAchievementPersonal".reason_comment AS "reasonComment",
            "EvaluationAchievementPersonal".title,
            "EvaluationAchievementPersonal".weight,
            "EvaluationAchievementPersonal".type
           FROM public.evaluation_achievement_personal_tbl "EvaluationAchievementPersonal"
          ORDER BY "EvaluationAchievementPersonal".item_no) t
  GROUP BY "evaluationId", type;


ALTER VIEW public.v_evaluation_achievement_personal OWNER TO "Haako";

--
-- Name: v_evaluation_basic_behavior; Type: VIEW; Schema: public; Owner: Haako
--

CREATE VIEW public.v_evaluation_basic_behavior AS
 SELECT "evaluationId",
    jsonb_agg(row_to_json(t.*)) AS "evaluationBasicBehaviors"
   FROM ( SELECT ebbt.evaluation_id AS "evaluationId",
            ebbt.item_title AS title,
            ebbt.item_no AS "itemNo",
            ebbt.content,
            ebbt.difficulty,
            ebbt.point_user AS "pointUser",
            ebbt.point_evaluator_0_5 AS "pointEvaluator05",
            ebbt.point_evaluator_1 AS "pointEvaluator1",
            ebbt.point_evaluator_2 AS "pointEvaluator2",
            ebbt.type,
            concat(
                CASE
                    WHEN (ebbt.type = 4) THEN 'basic-2-key-'::text
                    ELSE 'behavior-2-key-'::text
                END, ebbt.item_no) AS key,
            jsonb_build_object('type', ebbt.type) AS "versionBasicBehavior"
           FROM public.evaluation_basic_behavior_tbl ebbt
          ORDER BY ebbt.item_no) t
  GROUP BY "evaluationId";


ALTER VIEW public.v_evaluation_basic_behavior OWNER TO "Haako";

--
-- Name: v_evaluation_evaluator; Type: VIEW; Schema: public; Owner: Haako
--

CREATE VIEW public.v_evaluation_evaluator AS
 SELECT "evaluationId",
    jsonb_agg(jsonb_build_object('evaluationOrder', "evaluationOrder", 'evaluatorId', "evaluatorId", 'commentPublic', "commentPublic", 'commentPrivate', "commentPrivate", 'user', "user")) AS "user"
   FROM ( SELECT evaluator_tbl.evaluation_id AS "evaluationId",
            (evaluator_tbl.evaluation_order)::character varying AS "evaluationOrder",
            evaluator_tbl.evaluator_id AS "evaluatorId",
            evaluator_tbl.comment_public AS "commentPublic",
            evaluator_tbl.comment_private AS "commentPrivate",
            jsonb_build_object('employeeNumber', ut.employee_number, 'fullName', ut.full_name, ut.email, ut.email) AS "user"
           FROM (public.evaluator_tbl
             JOIN public.user_tbl ut ON ((evaluator_tbl.evaluator_id = ut.id)))
          ORDER BY (evaluator_tbl.evaluation_order)::character varying) t
  GROUP BY "evaluationId";


ALTER VIEW public.v_evaluation_evaluator OWNER TO "Haako";

--
-- Name: v_evaluation_pro; Type: VIEW; Schema: public; Owner: Haako
--

CREATE VIEW public.v_evaluation_pro AS
 SELECT "evaluationId",
    jsonb_agg(row_to_json(t.*)) AS "evaluationPros"
   FROM ( SELECT evaluation_pro_tbl.content,
            evaluation_pro_tbl.difficulty,
            evaluation_pro_tbl.item_id AS "itemId",
            evaluation_pro_tbl.item_id AS key,
            evaluation_pro_tbl.item_no AS "itemNo",
            evaluation_pro_tbl.item_title AS "itemTitle",
            evaluation_pro_tbl.job_type AS "jobType",
            evaluation_pro_tbl.note,
            evaluation_pro_tbl.point_user AS "pointUser",
            evaluation_pro_tbl.point_evaluator_0_5 AS "pointEvaluator05",
            evaluation_pro_tbl.point_evaluator_1 AS "pointEvaluator1",
            evaluation_pro_tbl.point_evaluator_2 AS "pointEvaluator2",
            evaluation_pro_tbl.total_point_user AS "totalPointUser",
            evaluation_pro_tbl.total_point_evaluator_0_5 AS "totalPointEvaluator05",
            evaluation_pro_tbl.total_point_evaluator_1 AS "totalPointEvaluator1",
            evaluation_pro_tbl.total_point_evaluator_2 AS "totalPointEvaluator2",
            evaluation_pro_tbl.evaluation_id AS "evaluationId",
            evaluation_pro_tbl.is_disable AS "isDisable"
           FROM public.evaluation_pro_tbl
          ORDER BY evaluation_pro_tbl.item_no) t
  GROUP BY "evaluationId";


ALTER VIEW public.v_evaluation_pro OWNER TO "Haako";

--
-- Name: v_setting_achievement_additional; Type: VIEW; Schema: public; Owner: Haako
--

CREATE VIEW public.v_setting_achievement_additional AS
 SELECT "versionId",
    type,
    jsonb_agg(json_build_object('point', point, 'rating', rating)) AS "arrayPoint"
   FROM ( SELECT saat.id,
            saat.version_id AS "versionId",
            saat.point,
            saat.note,
            saat.rating,
            saat.type
           FROM public.setting_achievement_additional_tbl saat
          ORDER BY saat.point DESC) t
  GROUP BY "versionId", type;


ALTER VIEW public.v_setting_achievement_additional OWNER TO "Haako";

--
-- Name: v_setting_achievement_personal; Type: VIEW; Schema: public; Owner: Haako
--

CREATE VIEW public.v_setting_achievement_personal AS
 SELECT "versionId",
    type,
    "typeEvaluation",
    jsonb_agg(json_build_object('point', point, 'type', type, 'note', note)) AS "arrayPoint"
   FROM ( SELECT sapt.id,
            sapt.version_id AS "versionId",
            sapt.point,
            sapt.note,
            sapt.type_evaluation AS "typeEvaluation",
            sapt.type
           FROM public.setting_achievement_personal_tbl sapt
          ORDER BY sapt.point DESC) t
  GROUP BY "versionId", type, "typeEvaluation";


ALTER VIEW public.v_setting_achievement_personal OWNER TO "Haako";

--
-- Name: v_setting_formula_8_10; Type: VIEW; Schema: public; Owner: Haako
--

CREATE VIEW public.v_setting_formula_8_10 AS
 SELECT "versionId",
    jsonb_agg(json_build_object('point', point, 'result', result)) AS "arrayPoint"
   FROM ( SELECT sft.id,
            sft.version_id AS "versionId",
            sft.point,
            sft.note,
            sft.result
           FROM public.setting_formula_8_10_tbl sft
          ORDER BY sft.point DESC) t
  GROUP BY "versionId";


ALTER VIEW public.v_setting_formula_8_10 OWNER TO "Haako";

--
-- Name: v_setting_point_basic_behavior_pro; Type: VIEW; Schema: public; Owner: Haako
--

CREATE VIEW public.v_setting_point_basic_behavior_pro AS
 SELECT "versionId",
    type,
    jsonb_agg(json_build_object('point', point, 'type', type)) AS "arrayPoint",
    max(point) AS "maxPoint"
   FROM ( SELECT spbbpt.id,
            spbbpt.version_id AS "versionId",
            spbbpt.type,
            spbbpt.point,
            spbbpt.note
           FROM public.setting_point_basic_behavior_pro_tbl spbbpt
          ORDER BY spbbpt.point DESC) t
  GROUP BY "versionId", type;


ALTER VIEW public.v_setting_point_basic_behavior_pro OWNER TO "Haako";

--
-- Name: version_setting_tbl; Type: TABLE; Schema: public; Owner: Haako
--

CREATE TABLE public.version_setting_tbl (
    id smallint NOT NULL,
    type smallint NOT NULL,
    version smallint NOT NULL,
    sub_version smallint NOT NULL,
    status smallint NOT NULL,
    creation_user smallint,
    reason character varying(501),
    basic_max_difficulty smallint,
    behavior_max_weight smallint,
    public_date character varying(16),
    last_updated_time character varying(16),
    created_time timestamp with time zone NOT NULL,
    updated_time timestamp with time zone NOT NULL,
    max_point_result numeric(8,2),
    min_point_result numeric(8,2),
    max_point_dep_result numeric(8,2),
    min_point_dep_result numeric(8,2),
    company_group_code character varying(20)
);


ALTER TABLE public.version_setting_tbl OWNER TO "Haako";

--
-- Name: v_setting_pro_formula_sub; Type: VIEW; Schema: public; Owner: Haako
--

CREATE VIEW public.v_setting_pro_formula_sub AS
 SELECT "versionId",
    jsonb_agg(row_to_json(t.*)) AS "arraySettingSub",
    max(point) AS "difficultyProMax"
   FROM ( SELECT "SettingProFormulaSub".id,
            "settingProFormula".version_id AS "versionId",
            "SettingProFormulaSub".formula_id AS "formulaId",
            "SettingProFormulaSub".total_item AS "totalItem",
            "SettingProFormulaSub".coefficient,
            "SettingProFormulaSub".formula_id,
            "settingProFormula".point,
            jsonb_build_object('id', "settingProFormula".id, 'versionId', "settingProFormula".version_id, 'point', "settingProFormula".point, 'note', "settingProFormula".note, 'version_id', "settingProFormula".version_id) AS "settingProFormula"
           FROM ((public.setting_pro_formula_sub_tbl "SettingProFormulaSub"
             JOIN public.setting_pro_formula_tbl "settingProFormula" ON (("SettingProFormulaSub".formula_id = "settingProFormula".id)))
             JOIN public.version_setting_tbl "settingProFormula->versionSetting" ON (("settingProFormula".version_id = "settingProFormula->versionSetting".id)))
          ORDER BY "SettingProFormulaSub".total_item DESC) t
  GROUP BY "versionId";


ALTER VIEW public.v_setting_pro_formula_sub OWNER TO "Haako";

--
-- Name: version_basic_behavior_tbl; Type: TABLE; Schema: public; Owner: Haako
--

CREATE TABLE public.version_basic_behavior_tbl (
    id integer NOT NULL,
    type smallint NOT NULL,
    level smallint,
    version smallint NOT NULL,
    sub_version smallint NOT NULL,
    status smallint NOT NULL,
    creation_user smallint,
    reason character varying(501),
    public_date character varying(16),
    last_updated_time character varying(16),
    created_time timestamp with time zone NOT NULL,
    updated_time timestamp with time zone NOT NULL,
    company_group_code character varying(20)
);


ALTER TABLE public.version_basic_behavior_tbl OWNER TO "Haako";

--
-- Name: v_version_basic_behavior; Type: VIEW; Schema: public; Owner: Haako
--

CREATE VIEW public.v_version_basic_behavior AS
 SELECT level,
    type,
    jsonb_agg(row_to_json(t.*)) AS "arrayList",
    "companyGroupCode"
   FROM ( SELECT row_number() OVER (ORDER BY lbbt.id_item) AS "itemNo",
            concat('behavior-2-key-', row_number() OVER (ORDER BY lbbt.id_item)) AS key,
            NULL::text AS "pointUser",
            NULL::text AS "pointEvaluator05",
            NULL::text AS "pointEvaluator1",
            NULL::text AS "pointEvaluator2",
            lbbt.title,
            lbbt.content,
            lbbt.difficulty,
            jsonb_build_object('type', "versionSettingBasicBehavior".type) AS "versionBasicBehavior",
            "versionSettingBasicBehavior".level,
            "versionSettingBasicBehavior".type,
            "versionSettingBasicBehavior".company_group_code AS "companyGroupCode"
           FROM (( SELECT vbbt.type,
                    vbbt.id,
                    vbbt.level,
                    vbbt.company_group_code
                   FROM public.version_basic_behavior_tbl vbbt
                  WHERE ((vbbt.status = 4) AND (vbbt.type = ANY (ARRAY[4, 5, 6])))) "versionSettingBasicBehavior"
             JOIN public.list_basic_behavior_tbl lbbt ON (("versionSettingBasicBehavior".id = lbbt.version_id)))
          ORDER BY lbbt.id_item) t
  GROUP BY level, "companyGroupCode", type;


ALTER VIEW public.v_version_basic_behavior OWNER TO "Haako";

