oup_code":"GNW"}	[]	[{"evaluation_id":1146,"item_no":0,"type":6,"item_title":"経営ビジョン・方針理解","content":"経営ビジョン・方針について経営陣として深く理解をしており、職場全体に波及する言動を心がけるとともに、配下従業員への落としこみを行えているか","difficulty":4,"point_user":null,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2025-12-30T08:06:30.582+00:00","updated_time":"2025-12-30T08:06:30.582+00:00"}, {"evaluation_id":1146,"item_no":1,"type":6,"item_title":"報告・連絡・相談\\t","content":"自身も全方位的に率先して報連相を行うと共に、配下従業員に対し適切な指導、指揮、命令、監督を行っているか","difficulty":3,"point_user":null,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2025-12-30T08:06:30.582+00:00","updated_time":"2025-12-30T08:06:30.582+00:00"}, {"evaluation_id":1146,"item_no":2,"type":6,"item_title":"知識\\t","content":"管掌部門および経営管理手法などに関する高度な専門知識を有し、運営推進や効率化を行えているか","difficulty":3,"point_user":null,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2025-12-30T08:06:30.582+00:00","updated_time":"2025-12-30T08:06:30.582+00:00"}, {"evaluation_id":1146,"item_no":3,"type":6,"item_title":"決断・判断","content":"会社の方針に沿いながら、管掌部門全体に関する問題の解決方向を的確に決断することができる能力を有し実践できているか","difficulty":5,"point_user":null,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2025-12-30T08:06:30.582+00:00","updated_time":"2025-12-30T08:06:30.582+00:00"}, {"evaluation_id":1146,"item_no":4,"type":6,"item_title":"統率・指導","content":"部、課、プロジェクトチームにて実行中の業務を適時把握し、必要に応じ評価、指導、指揮、命令、監督することにより、部下の執務意欲の向上や業務の効率的推進などの指導管理ができているか","difficulty":5,"point_user":null,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2025-12-30T08:06:30.582+00:00","updated_time":"2025-12-30T08:06:30.582+00:00"}, {"evaluation_id":1146,"item_no":5,"type":6,"item_title":"渉外・折衝","content":"管掌部門全般に関する業務について関係者と折衝し、納得性の高い解決ができる能力を有し実践できているか","difficulty":5,"point_user":null,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"create