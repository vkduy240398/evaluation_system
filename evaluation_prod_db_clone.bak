6	1620	{"id":1620,"evaluation_department_id":null,"department_name":"GEO SYSTEM SOLUTIONS VIETNAM（課）","division_name":"GEO SYSTEM SOLUTIONS VIETNAM（部署）","company_name":"株式会社ゲオストア","title":"2026年上期","period_start":"2026/6","period_end":"2026/6","status":49,"level":3,"comment_user":null,"skill_percent":35,"behavior_percent":35,"achievement_percent":30,"basic_pro_total_point_user":null,"basic_pro_total_point_evaluator_0_5":null,"basic_pro_total_point_evaluator_1":null,"basic_pro_total_point_evaluator_2":null,"basic_total_point_user":null,"basic_total_point_evaluator_0_5":null,"basic_total_point_evaluator_1":null,"basic_total_point_evaluator_2":null,"pro_total_point_user":null,"pro_total_point_evaluator_0_5":null,"pro_total_point_evaluator_1":null,"pro_total_point_evaluator_2":null,"behavior_total_point_user":null,"behavior_total_point_evaluator_0_5":null,"behavior_total_point_evaluator_1":null,"behavior_total_point_evaluator_2":null,"achievement_personal_total_point_user":null,"achievement_personal_total_point_evaluator_0_5":null,"achievement_personal_total_point_evaluator_1":null,"achievement_personal_total_point_evaluator_2":null,"achievement_additional_total_point_user":null,"achievement_additional_total_point_evaluator_0_5":null,"achievement_additional_total_point_evaluator_1":null,"achievement_additional_total_point_evaluator_2":null,"summary_point_user":null,"summary_point_evaluator_0_5":null,"summary_point_evaluator_1":null,"summary_point_evaluator_2":null,"summary_char_point_user":null,"summary_char_point_evaluator_0_5":null,"summary_char_point_evaluator_1":null,"summary_char_point_evaluator_2":null,"date_creation_goal_start":"2026/06/25","date_creation_goal_end":"2026/06/30","date_evaluation_start":null,"date_evaluation_end":null,"flag_skill":1,"percent_point":50,"user_id":415,"evaluation_period_id":13,"guide_version_id":9,"creation_user":1,"created_by_cronjob":1,"created_time":"2026-06-29T02:38:04.384558+00:00","updated_time":"2026-06-29T03:23:25.158+00:00","department_id":51,"division_id":50,"company_group_code":"GNW"}	[{"evaluation_id":1620,"job_type":"フロントSE","item_id":"4b0c_1_0","item_no":0,"item_title":"推進業務_企画推進_展示会やコミュニティへの参加","content":"明確な目的を持ち、展示会や勉強会、講演会へ参加し、他社や他部署と情報交換を行うことができ、実業務に生かすことができる","note":"５）明確な経営的・事業的課題の解決を目的として参加し、他社や専門家との高度な情報交換から、自社の既存枠組みを超えた新しいスキームや提携、企画を実現できる。\\n４）実業務への導入・改善を想定した目的を持ち、最新トレンドや他社事例を能動的に収集できる。得た知見を具体的な改善案としてアウトプットし、実業務に反映させられる。\\n３）自身の担当業務に関連する目的を持って参加し、他部署や他社担当者と適切な情報交換ができる。参加報告をまとめ、チーム内に有益な情報を共有できる。\\n２）上長等の推奨により参加し、展示内容や講演内容を正しく理解して持ち帰ることができる。業界の一般的な動向を把握しようとする姿勢がある。\\n１）指定された展示会や勉強会に参加し、まずは情報に触れる段階。社外の場におけるマナーや、情報収集の仕方を学び始めている状態。","difficulty":3,"point_user":null,"total_point_user":null,"point_evaluator_0_5":null,"total_point_evaluator_0_5":null,"point_evaluator_1":null,"total_point_evaluator_1":null,"point_evaluator_2":null,"total_point_evaluator_2":null,"created_time":"2026-06-29T02:56:17.429+00:00","updated_time":"2026-06-29T02:56:17.429+00:00","is_disable":false}, {"evaluation_id":1620,"job_type":"フロントSE","item_id":"tx8f_1_1","item_no":1,"item_title":"企画業務_企画推進_ファシリテーション","content":"会議の目的を達成するため、アジェンダ設計、論点整理、参加者の意見抽出、合意形成といった一連のプロセスを効果的に円滑な管理・運営できる。","note":"５）利害関係が鋭く対立する場や、正解のない経営判断等の極めて困難な会議において、中立性を保ちつつ場をコントロールし、組織にとって最善の合意形成を導き出すことができる。\\n４）\\t複雑なテーマに対し、事前の緻密なシナリオ設計（アジェンダ設計）を行い、多角的な視点から意見を引き出しながら、議論を構造化して本質的な結論へ導くことができる。\\t目的が明確な会議において、時間配分や論点の脱線を適切に管理できる。\\n３）参加者全員からバランスよく意見を抽出し、あらかじめ設定したゴールに向けて納得感のある合意を作れる。\\n２）定例会議や進捗確認など、定型的な会議の進行ができる。アジェンダに沿って発言を促し、決定事項やネクストアクションを議事録としてまとめることができる。\\n１）会議の招集や資料配布などの事前準備ができる。実際の進行においては、上長のサポートを受けながら、決められたアジェンダ通りに発言を回そうと努める段階。","difficulty":4,"point_user":null,"total_point_user":null,"point_evaluator_0_5":null,"total_point_evaluator_0_5":null,"point_evaluator_1":null,"total_point_evaluator_1":null,"point_evaluator_2":null,"total_point_evaluator_2":null,"created_time":"2026-06-29T02:56:17.429+00:00","updated_time":"2026-06-29T02:56:17.429+00:00","is_disable":false}]	[{"evaluation_id":1620,"item_no":0,"type":1,"item_title":"社会責任\\n倫理","content":"社会人として自覚および社会的責任を持ち、日常業務に関する法的または倫理的な問題についても常に問題意識を持って取り組んでいる。","difficulty":1,"point_user":null,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-06-29T02:56:17.546+00:00","updated_time":"2026-06-29T02:56:17.546+00:00"}, {"evaluation_id":1620,"item_no":1,"type":1,"item_title":"業務計画","content":"社内・部署内で定められたスケジュールと自身のスケジュールに矛盾がなく、業務のロスとなるムダの発見と除去を行い、業務を推進している。","difficulty":1,"point_user":null,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-06-29T02:56:17.546+00:00","updated_time":"2026-06-29T02:56:17.546+00:00"}, {"evaluation_id":1620,"item_no":2,"type":1,"item_title":"リスク管理\\n問題意識","content":"業務上知り得た機密について漏洩や盗用が発生しないよう意識しており、自身が関連する職務や分野の時事問題について関心を持ち問題意識を持って取り組んでいる。","difficulty":1,"point_user":null,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-06-29T02:56:17.546+00:00","updated_time":"2026-06-29T02:56:17.546+00:00"}, {"evaluation_id":1620,"item_no":3,"type":1,"item_title":"安全指針\\n健康管理","content":"会社や所属部署における業務遂行上の安全に係る規程やルールを正確に把握し、遵守している。また、自身の健康状態を把握し上司へ適切に報告・連絡・相談を行っている。","difficulty":1,"point_user":null,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-06-29T02:56:17.546+00:00","updated_time":"2026-06-29T02:56:17.546+00:00"}, {"evaluation_id":1620,"item_no":4,"type":1,"item_title":"業務遂行","content":"業務遂行上の疑問点や不明点などについて、関係者への適時確認を行い適切に業務を遂行している。また、他部署の役割を理解し、助言や質問を求められた際には快く対応している。","difficulty":1,"point_user":null,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-06-29T02:56:17.546+00:00","updated_time":"2026-06-29T02:56:17.546+00:00"}, {"evaluation_id":1620,"item_no":5,"type":1,"item_title":"交渉・折衝","content":"説明事項を簡潔に漏れなく伝えることができ、事実と意見を区別し、適切な態度と言葉遣いで折衝や打ち合わせを行うことができている。","difficulty":1,"point_user":null,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-06-29T02:56:17.546+00:00","updated_time":"2026-06-29T02:56:17.546+00:00"}, {"evaluation_id":1620,"item_no":6,"type":2,"item_title":"経営ビジョン・\\n方針理解","content":"経営ビジョン・方針について理解を深め、自身の仕事においてどのような実践が必要であるかを常に考え行動している","difficulty":3,"point_user":null,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-06-29T02:56:17.546+00:00","updated_time":"2026-06-29T02:56:17.546+00:00"}, {"evaluation_id":1620,"item_no":7,"type":2,"item_title":"報告・連絡・相談","content":"担当業務の全体の流れを理解し、報連相を率先して行っている","difficulty":4,"point_user":null,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-06-29T02:56:17.546+00:00","updated_time":"2026-06-29T02:56:17.546+00:00"}, {"evaluation_id":1620,"item_no":8,"type":2,"item_title":"表現","content":"伝達しようとする情報・意図を文書又は口頭で的確、簡潔に表現できているか","difficulty":4,"point_user":null,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-06-29T02:56:17.546+00:00","updated_time":"2026-06-29T02:56:17.546+00:00"}, {"evaluation_id":1620,"item_no":9,"type":2,"item_title":"工夫","content":"上司から個別的に示された担当業務の問題に対して、効果的な解決策の立案や創意工夫をしているか","difficulty":4,"point_user":null,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-06-29T02:56:17.546+00:00","updated_time":"2026-06-29T02:56:17.546+00:00"}, {"evaluation_id":1620,"item_no":10,"type":2,"item_title":"変革行動","content":"自身の担当職務に関する業務改善・変革のための施策を立案・実行できているか","difficulty":4,"point_user":null,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-06-29T02:56:17.546+00:00","updated_time":"2026-06-29T02:56:17.546+00:00"}, {"evaluation_id":1620,"item_no":11,"type":2,"item_title":"向上心・\\n自己啓発","content":"現状に満足することなく、常に前向きに組織や自分自身のレベルアップに努めているか","difficulty":4,"point_user":null,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-06-29T02:56:17.546+00:00","updated_time":"2026-06-29T02:5