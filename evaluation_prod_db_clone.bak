5107	\N	[{"key":"x2v4_0_1","note":"","itemId":"x2v4_0_1","itemNo":1,"content":"メンバーが設定した目標が具体的で、達成可能なものであることを確認し、目標を達成するためのアクションプランを作成することを支援する能力","jobType":"マネジメント層\\n※15項目以上選択必須","isDisable":true,"itemTitle":"マネジメント_コーチング_目標設定","pointUser":null,"difficulty":3,"evaluationId":840,"pointEvaluator1":null,"pointEvaluator2":null,"pointEvaluator05":null},{"key":"ucm8_0_2","note":"","itemId":"ucm8_0_2","itemNo":2,"content":"メンバーの成長を促すために、適切なフィードバックを提供できるか。また、メンバーが達成した成果や改善点を認め、肯定的なフィードバックを提供することで、メンバーの自信を高めることができる能力","jobType":"マネジメント層\\n※15項目以上選択必須","isDisable":true,"itemTitle":"マネジメント_コーチング_フィードバック","pointUser":null,"difficulty":3,"evaluationId":840,"pointEvaluator1":null,"pointEvaluator2":null,"pointEvaluator05":null},{"key":"a2ku_0_3","note":"","itemId":"a2ku_0_3","itemNo":3,"content":"メンバーの状況や気持ち、直面する問題や課題に対して理解を示し、メンバー自身が問題を解決するための答えを見つけることを支援する能力","jobType":"マネジメント層\\n※15項目以上選択必須","isDisable":true,"itemTitle":"マネジメント_コーチング_エンパシー","pointUser":null,"difficulty":3,"evaluationId":840,"pointEvaluator1":null,"pointEvaluator2":null,"pointEvaluator05":null},{"key":"t4g4_0_4","note":"","itemId":"t4g4_0_4","itemNo":4,"content":"適切な質問を投げかけることで、メンバー自身が問題を理解し、自己啓発につながる答えを見つける手助けをする能力","jobType":"マネジメント層\\n※15項目以上選択必須","isDisable":true,"itemTitle":"マネジメント_コーチング_問いかけ","pointUser":null,"difficulty":3,"evaluationId":840,"pointEvaluator1":null,"pointEvaluator2":null,"pointEvaluator05":null},{"key":"auhc_0_5","note":"","itemId":"auhc_0_5","itemNo":5,"content":"対話によってメンバーに気づきを与えることができ、ストレスの原因に対する認知や行動を変化させたり、対処法に気づかせたりすることで、メンバーのストレスの軽減を手助けする能力","jobType":"マネジメント層\\n※15項目以上選択必須","isDisable":true,"itemTitle":"マネジメント_コーチング_メンタルケア","pointUser":null,"difficulty":3,"evaluationId":840,"pointEvaluator1":null,"pointEvaluator2":null,"pointEvaluator05":null},{"key":"90j7_0_6","note":"","itemId":"90j7_0_6","itemNo":6,"content":"発生する技術的な問題を特定し、問題解決のための戦略を立てる知見と能力。例）エンジニアリングプロセス全体の理解、プログラミング言語やデータベース、フレームワークなどの技術的な知識、または職種に応じた主要業務における全体理解と様々な知見の保有","jobType":"マネジメント層\\n※15項目以上選択必須","isDisable":true,"itemTitle":"マネジメント_専門性_問題の特定","pointUser":null,"difficulty":3,"evaluationId":840,"pointEvaluator1":null,"pointEvaluator2":null,"pointEvaluator05":null},{"key":"zoy2_0_7","note":"","itemId":"zoy2_0_7","itemNo":7,"content":"技術的な問題に対して的確な解決策を提案する知見と能力。例）コードレビュー、アーキテクチャデザイン、パフォーマンス改善、スケーラビリティの向上など、エンジニアリングに関する専門的な知識、または職種に応じた主要業務における深い知識と多様な経験","jobType":"マネジメント層\\n※15項目以上選択必須","isDisable":true,"itemTitle":"マネジメント_専門性_解決策の提案","pointUser":null,"difficulty":3,"evaluationId":840,"pointEvaluator1":null,"pointEvaluator2":null,"pointEvaluator05":null},{"key":"vbd4_0_8","note":"","itemId":"vbd4_0_8","itemNo":8,"content":"表面的なものだけでなく、見えていない部分も注意深く確認し考察し、複数のアプローチを行い、異なる視点からも解決策を探れる力","jobType":"マネジメント層\\n※15項目以上選択必須","isDisable":true,"itemTitle":"マネジメント_専門性_抽象化能力","pointUser":null,"difficulty":3,"evaluationId":840,"pointEvaluator1":null,"pointEvaluator2":null,"pointEvaluator05":null},{"key":"ht72_0_9","note":"","itemId":"ht72_0_9","itemNo":9,"content":"個々の技術的なスキルについて、理解度・熟練度などを評価する能力","jobType":"マネジメント層\\n※15項目以上選択必須","isDisable":true,"itemTitle":"マネジメント_専門性_スキル評価","pointUser":null,"difficulty":3,"evaluationId":840,"pointEvaluator1":null,"pointEvaluator2":null,"pointEvaluator05":null},{"key":"2b3w_0_10","note":"","itemId":"2b3w_0_10","itemNo":10,"content":"最新の技術的なトレンドについても理解している、業界の動向や競合他社の活動に関する情報収集や、新しい技術やツールの学習に取り組む能力","jobType":"マネジメント層\\n※15項目以上選択必須","isDisable":true,"itemTitle":"マネジメント_専門性_トレンド理解","pointUser":null,"difficulty":3,"evaluationId":840,"pointEvaluator1":null,"pointEvaluator2":null,"pointEvaluator05":null},{"key":"w8la_0_11","note":"","itemId":"w8la_0_11","itemNo":11,"content":"業界のトレンドと法・規制・ルールの理解及び、市場機会を評価し変化に適応させる能力","jobType":"マネジメント層\\n※15項目以上選択必須","isDisable":true,"itemTitle":"マネジメント_専門性_小売・物流・リユース業界の理解","pointUser":null,"difficulty":3,"evaluationId":840,"pointEvaluator1":null,"pointEvaluator2":null,"pointEvaluator05":null},{"key":"xjzk_0_12","note":"","itemId":"xjzk_0_12","itemNo":12,"content":"財務計画の策定とコスト効率化を推進する能力。\\n投資の評価とROIの最大化実績","jobType":"マネジメント層\\n※15項目以上選択必須","isDisable":true,"itemTitle":"マネジメント_専門性_財務・コスト管理","pointUser":null,"difficulty":3,"evaluationId":840,"pointEvaluator1":null,"pointEvaluator2":null,"pointEvaluator05":null},{"key":"ih78_0_13","note":"","itemId":"ih78_0_13","itemNo":13,"content":"メンバーや上司、他部署の人々の話をよく聞き、相手の意見や問題点を理解する能力。また、聴くことで相手が話しやすくなり、良好な関係性を築ける","jobType":"マネジメント層\\n※15項目以上選択必須","isDisable":true,"itemTitle":"マネジメント_コミュニケーション_ヒヤリング","pointUser":null,"difficulty":3,"evaluationId":840,"pointEvaluator1":null,"pointEvaluator2":null,"pointEvaluator05":null},{"key":"5djs_0_14","note":"","itemId":"5djs_0_14","itemNo":14,"content":"相手に理解してもらうために自分の意見や考えを分かりやすく説明する能力。例）技術的な問題やプロジェクトの進行状況などを分かりやすく説明のうえ相手に伝えることができる。ときには相手の立場や経験値、状況を踏まえ話し方や言葉の選択に配慮し伝えることができる","jobType":"マネジメント層\\n※15項目以上選択必須","isDisable":true,"itemTitle":"マネジメント_コミュニケーション_説明","pointUser":null,"difficulty":3,"evaluationId":840,"pointEvaluator1":null,"pointEvaluator2":null,"pointEvaluator05":null},{"key":"u3uj_0_15","note":"","itemId":"u3uj_0_15","itemNo":15,"content":"プロダクトのビジョンやタスクの進捗状況などを文書化し、メンバーや上司に報告する能力","jobType":"マネジメント層\\n※15項目以上選択必須","isDisable":true,"itemTitle":"マネジメント_コミュニケーション_文書化","pointUser":null,"difficulty":3,"evaluationId":840,"pointEvaluator1":null,"pointEvaluator2":null,"pointEvaluator05":null},{"key":"4qyv_0_16","note":"","itemId":"4qyv_0_16","itemNo":16,"content":"経営目標に対する長期・中期戦略を策定し、組織力を長期的に推進する能力\\n国内と海外の市場差分を理解し、グローバルな戦略を計画・推進する","jobType":"マネジメント層\\n※15項目以上選択必須","isDisable":true,"itemTitle":"マネジメント_コラボレーション_戦略立案と実行","pointUser":null,"difficulty":3,"evaluationId":840,"pointEvaluator1":null,"pointEvaluator2":null,"pointEvaluator05":null},{"key":"4xr6_0_17","note":"","itemId":"4xr6_0_17","itemNo":17,"content":"管轄組織におけるメンバーの関係性を良好に保ち、組織全体として目標に向かって協力し合うことができるように導く能力","jobType":"マネジメント層\\n※15項目以上選択必須","isDisable":true,"itemTitle":"マネジメント_コラボレーション_チームビルディング","pointUser":null,"difficulty":3,"evaluationId":840,"pointEvaluator1":null,"pointEvaluator2":null,"pointEvaluator05":null},{"key":"alcb_0_18","note":"","itemId":"alcb_0_18","itemNo":18,"content":"ミーティングやワークショップなどの場で、議論を促し、意見をまとめ、解決策を導き出す能力","jobType":"マネジメント層\\n※15項目以上選択必須","isDisable":true,"itemTitle":"マネジメント_コラボレーション_ファシリテーション","pointUser":null,"difficulty":3,"evaluationId":840,"pointEvaluator1":null,"pointEvaluator2":null,"pointEvaluator05":null},{"key":"0s2y_0_19","note":"","itemId":"0s2y_0_19","itemNo":19,"content":"管轄組織のメンバーにおける急な休みや休職・退場者の穴埋めなど、突発的に発生した事象に対して、協力し補い合い当該事案の対応を進めることができるか。また、その解消に向けた対策を実行し解決することができるか","jobType":"マネジメント層\\n※15項目以上選択必須","isDisable":true,"itemTitle":"マネジメント_コラボレーション_フォロー","pointUser":null,"difficulty":3,"evaluationId":840,"pointEvaluator1":null,"pointEvaluator2":null,"pointEvaluator05":null},{"key":"q8xt_0_20","note":"","itemId":"q8xt_0_20","itemNo":20,"content":"各国の文化、ルールの理解し、英語などの共通言語を活用して合意形成を行う能力","jobType":"マネジメント層\\n※15項目以上選択必須","isDisable":true,"itemTitle":"マネジメント_コラボレーション_グローバルコミュニケーション","pointUser":null,"difficulty":3,"evaluationId":840,"pointEvaluator1":null,"pointEvaluator2":null,"pointEvaluator05":null},{"key":"vkej_0_21","note":"","itemId":"vkej_0_21","itemNo":21,"content":"自社・部門・自身の問題点を発見し、数字と正しい言葉で記録できる能力","jobType":"マネジメント層\\n※15項目以上選択必須","isDisable":true,"itemTitle":"マネジメント_決断力_観察","pointUser":null,"difficulty":3,"evaluationId":840,"pointEvaluator1":null,"pointEvaluator2":null,"pointEvaluator05":null},{"key":"f3qj_0_22","note":"","itemId":"f3qj_0_22","itemNo":22,"content":"『観察』によって発見した問題点について、原因や事情を推察し、現場・現物で確かめ事実と事情の確定をする能力","jobType":"マネジメント層\\n※15項目以上選択必須","isDisable":true,"itemTitle":"マネジメント_決断力_分析","pointUser":null,"difficulty":3,"evaluationId":840,"pointEvaluator1":null,"pointEvaluator2":null,"pointEvaluator05":null},{"key":"9lt6_0_23","note":"","itemId":"9lt6_0_23","itemNo":23,"content":"分析結果に対して有効な改善案（応急処置）と改革案（新たな制度・仕組み）を起案できる能力","jobType":"マネジメント層\\n※15項目以上選択必須","isDisable":true,"itemTitle":"マネジメント_決断力_判断","pointUser":null,"difficulty":3,"evaluationId":840,"pointEvaluator1":null,"pointEvaluator2":null,"pointEvaluator05":null},{"key":"d4wm_0_24","note":"","