00:00","is_disable":false}, {"evaluation_id":1148,"job_type":"ディレクター","item_id":"vg6h_0_0","item_no":0,"item_title":"企画業務_企画_ビジネスの知識","content":"グループ全体のビジネスモデル・数値の把握、競合他社・市場の動向を把握し企画業務に活かす事ができる","note":null,"difficulty":3,"point_user":2,"total_point_user":10,"point_evaluator_0_5":null,"total_point_evaluator_0_5":0,"point_evaluator_1":null,"total_point_evaluator_1":0,"point_evaluator_2":null,"total_point_evaluator_2":0,"created_time":"2026-01-26T05:07:18.604+00:00","updated_time":"2026-01-26T05:07:18.604+00:00","is_disable":false}, {"evaluation_id":1148,"job_type":"プロジェクトマネージャー","item_id":"vkbv_0_9","item_no":9,"item_title":"運営業務_プロジェクトマネジメント_ステークホルダーマネジメント","content":"ステークホルダーと良好な関係を構築しプロジェクトが円滑に進める事ができる","note":null,"difficulty":3,"point_user":3,"total_point_user":15,"point_evaluator_0_5":null,"total_point_evaluator_0_5":0,"point_evaluator_1":null,"total_point_evaluator_1":0,"point_evaluator_2":null,"total_point_evaluator_2":0,"created_time":"2026-01-26T05:07:18.604+00:00","updated_time":"2026-01-26T05:07:18.604+00:00","is_disable":false}]	[{"evaluation_id":1148,"item_no":0,"type":1,"item_title":"社会責任\\n倫理","content":"社会人として自覚および社会的責任を持ち、日常業務に関する法的または倫理的な問題についても常に問題意識を持って取り組んでいる。","difficulty":1,"point_user":2,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-01-26T05:07:18.633+00:00","updated_time":"2026-01-26T05:07:18.633+00:00"}, {"evaluation_id":1148,"item_no":1,"type":1,"item_title":"業務計画","content":"社内・部署内で定められたスケジュールと自身のスケジュールに矛盾がなく、業務のロスとなるムダの発見と除去を行い、業務を推進している。","difficulty":1,"point_user":3,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-01-26T05:07:18.633+00:00","updated_time":"2026-01-26T05:07:18.633+00:00"}, {"evaluation_id":1148,"item_no":2,"type":1,"item_title":"リスク管理\\n問題意識","content":"業務上知り得た機密について漏洩や盗用が発生しないよう意識しており、自身が関連する職務や分野の時事問題について関心を持ち問題意識を持って取り組んでいる。","difficulty":1,"point_user":2,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-01-26T05:07:18.633+00:00","updated_time":"2026-01-26T05:07:18.633+00:00"}, {"evaluation_id":1148,"item_no":3,"type":1,"item_title":"安全指針\\n健康管理","content":"会社や所属部署における業務遂行上の安全に係る規程やルールを正確に把握し、遵守している。また、自身の健康状態を把握し上司へ適切に報告・連絡・相談を行っている。","difficulty":1,"point_user":3,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-01-26T05:07:18.633+00:00","updated_time":"2026-01-26T05:07:18.633+00:00"}, {"evaluation_id":1148,"item_no":4,"type":1,"item_title":"業務遂行","content":"業務遂行上の疑問点や不明点などについて、関係者への適時確認を行い適切に業務を遂行している。また、他部署の役割を理解し、助言や質問を求められた際には快く対応している。","difficulty":1,"point_user":2,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-01-26T05:07:18.633+00:00","updated_time":"2026-01-26T05:07:18.633+00:00"}, {"evaluation_id":1148,"item_no":5,"type":1,"item_title":"交渉・折衝","content":"説明事項を簡潔に漏れなく伝えることができ、事実と意見を区別し、適切な態度と言葉遣いで折衝や打ち合わせを行うことができている。","difficulty":1,"point_user":3,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-01-26T05:07:18.633+00:00","updated_time":"2026-01-26T05:07:18.633+00:00"}, {"evaluation_id":1148,"item_no":6,"type":2,"item_title":"経営ビジョン・\\n方針理解","content":"経営ビジョン・方針について理解を深め、自身の仕事においてどのような実践が必要であるかを常に考え行動している","difficulty":3,"point_user":4,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-01-26T05:07:18.638+00:00","updated_time":"2026-01-26T05:07:18.638+00:00"}, {"evaluation_id":1148,"item_no":7,"type":2,"item_title":"報告・連絡・相談","content":"担当業務の全体の流れを理解し、報連相を率先して行っている","difficulty":4,"point_user":5,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-01-26T05:07:18.638+00:00","updated_time":"2026-01-26T05:07:18.638+00:00"}, {"evaluation_id":1148,"item_no":8,"type":2,"item_title":"表現","content":"伝達しようとする情報・意図を文書又は口頭で的確、簡潔に表現できているか","difficulty":4,"point_user":4,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-01-26T05:07:18.638+00:00","updated_time":"2026-01-26T05:07:18.638+00:00"}, {"evaluation_id":1148,"item_no":9,"type":2,"item_title":"工夫","content":"上司から個別的に示された担当業務の問題に対して、効果的な解決策の立案や創意工夫をしているか","difficulty":4,"point_user":3,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-01-26T05:07:18.638+00:00","updated_time":"2026-01-26T05:07:18.638+00:00"}, {"evaluation_id":1148,"item_no":10,"type":2,"item_title":"変革行動","content":"自身の担当職務に関する業務改善・変革のための施策を立案・実行できているか","difficulty":4,"point_user":4,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-01-26T05:07:18.638+00:00","updated_time":"2026-01-26T05:07:18.638+00:00"}, {"evaluation_id":1148,"item_no":11,"type":2,"item_title":"向上心・\\n自己啓発","content":"現状に満足することなく、常に前向きに組織や自分自身のレベルアップに努めているか","difficulty":4,"point_user":3,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-01-26T05:07:18.638+00:00","updated_time":"2026-01-26T05:07:18.638+00:00"}, {"evaluation_id":1148,"item_no":12,"type":2,"item_title":"5Sの徹底","content":"5Sの意味を理解し、自身の行動を徹底しているか","difficulty":3,"point_user":2,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-01-26T05:07:18.638+00:00","updated_time":"2026-01-26T05:07:18.638+00:00"}, {"evaluation_id":1148,"item_no":13,"type":2,"item_title":"勤怠","content":"遅刻、欠勤もなく、社会人として最低限の行動を徹底しているか","difficulty":4,"point_user":5,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-01-26T05:07:18.638+00:00","updated_time":"2026-01-26T05:07:18.638+00:00"}, {"evaluation_id":1148,"item_no":14,"type":2,"item_title":"勤務態度","content":"社内での生活、業務上の態度を意識し行動できているか","difficulty":4,"point_user":4,"point_evaluator_0_5":null,"point_evaluator_1":null,"point_evaluator_2":null,"created_time":"2026-01-26T05:07:18.638+00:00","updated_time":"2026-01-26T