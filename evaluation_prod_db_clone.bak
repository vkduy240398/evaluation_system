--
-- Name: evaluator_default_tbl evaluator_default_tbl_trigger; Type: TRIGGER; Schema: public; Owner: Haako
--

CREATE TRIGGER evaluator_default_tbl_trigger AFTER INSERT OR DELETE OR UPDATE ON public.evaluator_default_tbl FOR EACH ROW EXECUTE FUNCTION public.trigger_evaluator_default_tbl();


--
-- Name: evaluator_tbl evaluator_tbl_trigger; Type: TRIGGER; Schema: public; Owner: Haako
--

CREATE TRIGGER evaluator_tbl_trigger AFTER INSERT OR DELETE OR UPDATE ON public.evaluator_tbl FOR EACH ROW EXECUTE FUNCTION public.trigger_evaluator_tbl();


--
-- Name: history_mail_tbl history_mail_changes_trigger; Type: TRIGGER; Schema: public; Owner: Haako
--

CREATE TRIGGER history_mail_changes_trigger AFTER INSERT OR UPDATE ON public.history_mail_tbl FOR EACH ROW WHEN (((new.type = ANY (ARRAY[7, 8, 25, 26, 27, 28])) AND (new.status = 0))) EXECUTE FUNCTION public.notify_history_mail_change();


--
-- Name: evaluation_tbl set_evaluation_department_id; Type: TRIGGER; Schema: public; Owner: Haako
--

CREATE TRIGGER set_evaluation_department_id AFTER UPDATE OF status ON public.evaluation_tbl FOR EACH ROW WHEN ((new.status = 100)) EXECUTE FUNCTION public.update_evaluation_department_id();


--
-- Name: version_setting_tbl version_setting_trigger; Type: TRIGGER; Schema: public; Owner: Haako
--

CREATE TRIGGER version_setting_trigger AFTER INSERT OR UPDATE ON public.version_setting_tbl FOR EACH ROW EXECUTE FUNCTION public.handle_version_setting_changes();


